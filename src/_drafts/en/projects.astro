---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Partner from '~/components/Partner.astro';
import Section from '~/components/Section.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { t } from '~/i18n';
import { CONTACT_EMAIL } from '~/data/contact';

const lang = 'en' as const;
const strings = t(lang);
const page = strings.pages.projects;

const all = await getCollection('partners', (e) => e.data.lang === lang && e.data.kind === 'project');
all.sort((a, b) => a.data.order - b.data.order);

const projects = await Promise.all(
  all.map(async (entry) => {
    const { Content } = await render(entry);
    return { data: entry.data, Content };
  }),
);
---
<BaseLayout title={page.title} description={page.lead} lang={lang}>
  <PageHeader number="04 / Projects" heading={page.heading} lead={page.lead} />

  <Section>
    {projects.length > 0 ? (
      <>
        {projects.map(({ data, Content }) => (
          <Partner name={data.name} url={data.url} kind={data.kind}>
            <Content />
          </Partner>
        ))}
        <div class="border-t border-rule" />
      </>
    ) : (
      <p class="text-muted">Coming soon.</p>
    )}
  </Section>

  <ContactCTA lang={lang} contactHref={`mailto:${CONTACT_EMAIL}`} />
</BaseLayout>
