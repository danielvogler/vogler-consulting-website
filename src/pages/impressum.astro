---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import { t } from '~/i18n';

const lang = 'de' as const;
const strings = t(lang);
const page = strings.pages.impressum;

const CONTACT_EMAIL = import.meta.env.CONTACT_EMAIL || 'daniel@vogler-consulting.ch';
---
<BaseLayout title={page.title} description="Impressum" lang={lang}>
  <PageHeader heading={page.heading} />

  <Section>
    <div class="prose-block grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-3">
        <p class="text-sm tracking-wider uppercase text-muted">Anbieter</p>
      </div>
      <div class="col-span-12 md:col-span-9 space-y-4 text-base text-ink/85 leading-relaxed">
        <p>
          <strong class="text-ink">VOGLER CONSULTING</strong><br />
          Einzelfirma<br />
          Inhaber: Dr. Daniel Vogler
        </p>
        <p>
          Staeblistr. 1<br />
          8006 Zürich<br />
          Schweiz
        </p>
        <p>UID: CHE-191.414.241</p>
        <p>
          E-Mail:&nbsp;
          <a href={`mailto:${CONTACT_EMAIL}`} class="link-underline">{CONTACT_EMAIL}</a>
        </p>
      </div>
    </div>
  </Section>

  <Section bordered>
    <div class="grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-3">
        <p class="text-sm tracking-wider uppercase text-muted">Haftung für Inhalte</p>
      </div>
      <div class="col-span-12 md:col-span-9 space-y-4 text-base text-ink/85 leading-relaxed max-w-3xl">
        <p>
          Die Inhalte dieser Website werden mit grösster Sorgfalt erstellt. Für die Richtigkeit, Vollständigkeit
          und Aktualität der Inhalte kann jedoch keine Gewähr übernommen werden.
        </p>
        <p>
          Verlinkungen auf externe Websites liegen ausserhalb unseres Verantwortungsbereichs. Es wird jegliche
          Verantwortung für solche Websites abgelehnt.
        </p>
      </div>
    </div>
  </Section>

  <Section bordered>
    <div class="grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-3">
        <p class="text-sm tracking-wider uppercase text-muted">Urheberrecht</p>
      </div>
      <div class="col-span-12 md:col-span-9 text-base text-ink/85 leading-relaxed max-w-3xl">
        <p>
          Texte und Grafiken auf dieser Website unterliegen dem Schweizer Urheberrecht. Eine Vervielfältigung oder
          Verwendung ausserhalb der gesetzlichen Schranken bedarf der schriftlichen Zustimmung von VOGLER
          CONSULTING. Logos Dritter sind Marken der jeweiligen Inhaber und werden unter der Simple-Icons-Lizenz
          (CC0) verwendet, ohne eine Partnerschaft oder ein Endorsement zu implizieren.
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>
