---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import TeamMember from '~/components/TeamMember.astro';
import Partner from '~/components/Partner.astro';
import Section from '~/components/Section.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { t } from '~/i18n';

const lang = 'de' as const;
const strings = t(lang);
const page = strings.pages.team;

const teamEntries = await getCollection('team', (e) => e.data.lang === lang);
teamEntries.sort((a, b) => a.data.order - b.data.order);

const members = await Promise.all(
  teamEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { data: entry.data, Content };
  }),
);

const partnerEntries = await getCollection('partners', (e) => e.data.lang === lang && e.data.kind === 'partner');
partnerEntries.sort((a, b) => a.data.order - b.data.order);

const partners = await Promise.all(
  partnerEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { data: entry.data, Content };
  }),
);

const CONTACT_EMAIL = import.meta.env.CONTACT_EMAIL || 'daniel@vogler-consulting.ch';
---
<BaseLayout title={page.title} description={page.lead} lang={lang}>
  <PageHeader number="03 / Team" heading={page.heading} lead={page.lead} />

  <Section>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 md:gap-16">
      {members.map(({ data, Content }) => (
        <TeamMember name={data.name} role={data.role} photo={data.photo} linkedin={data.linkedin}>
          <Content />
        </TeamMember>
      ))}
    </div>
  </Section>

  {partners.length > 0 && (
    <Section bordered>
      <h2 class="text-sm tracking-wider uppercase text-accent mb-8">{page.partnersHeading}</h2>
      {partners.map(({ data, Content }) => (
        <Partner name={data.name} url={data.url} kind={data.kind}>
          <Content />
        </Partner>
      ))}
      <div class="border-t border-rule" />
    </Section>
  )}

  <ContactCTA lang={lang} contactHref={`mailto:${CONTACT_EMAIL}`} />
</BaseLayout>
