---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { t } from '~/i18n';

const lang = 'en' as const;
const strings = t(lang);
const page = strings.pages.about;

const CONTACT_EMAIL = import.meta.env.CONTACT_EMAIL || 'daniel@vogler-consulting.ch';
---
<BaseLayout title={page.title} description={page.lead} lang={lang}>
  <PageHeader number="02 / About" heading={page.heading} lead={page.lead} />

  <Section>
    <div class="grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-3">
        <p class="text-sm tracking-wider uppercase text-accent">Approach</p>
      </div>
      <div class="col-span-12 md:col-span-9 space-y-6 text-lg text-ink/85 leading-relaxed max-w-3xl">
        <p>
          VOGLER CONSULTING is a Swiss company focused on data-driven and agentic AI solutions.
          We combine solid data-engineering practices with modern cloud architectures and deliver measurable results,
          not demos.
        </p>
        <p>
          We work in three modes: as a delivery partner for tailored applications, pipelines, and products, as a
          sparring partner for strategy, roadmap, and internal initiatives, or as a workshop partner training
          teams in the right practices.
        </p>
      </div>
    </div>
  </Section>

  <Section bordered>
    <div class="grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-3">
        <p class="text-sm tracking-wider uppercase text-accent">Values</p>
      </div>
      <div class="col-span-12 md:col-span-9 grid sm:grid-cols-2 gap-x-10 gap-y-8 max-w-3xl">
        <div>
          <h3 class="text-xl tracking-tight font-medium">Result-oriented</h3>
          <p class="mt-2 text-sm text-muted">Impact over activity. What counts is the outcome.</p>
        </div>
        <div>
          <h3 class="text-xl tracking-tight font-medium">Pragmatic</h3>
          <p class="mt-2 text-sm text-muted">The simplest thing that works.</p>
        </div>
        <div>
          <h3 class="text-xl tracking-tight font-medium">Robust</h3>
          <p class="mt-2 text-sm text-muted">Production-ready, from day one.</p>
        </div>
        <div>
          <h3 class="text-xl tracking-tight font-medium">Transparent</h3>
          <p class="mt-2 text-sm text-muted">Clear roadmap, clear communication, clear handover.</p>
        </div>
      </div>
    </div>
  </Section>

  <ContactCTA lang={lang} contactHref={`mailto:${CONTACT_EMAIL}`} />
</BaseLayout>
