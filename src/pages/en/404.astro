---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import { getNavLinks, t } from '~/i18n';

const lang = 'en' as const;
const strings = t(lang);
const navLinks = getNavLinks(lang);
---

<BaseLayout title="404, VOGLER CONSULTING" description="Page not found" lang={lang}>
  <PageHeader heading="404" lead="This page does not exist." />

  <Section>
    <div class="grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-3">
        <p class="text-sm tracking-wider uppercase text-accent">Navigation</p>
      </div>
      <div class="col-span-12 md:col-span-9 space-y-4">
        <p class="text-lg text-ink/85">
          The page you are looking for was not found. Try one of these pages:
        </p>
        <ul class="space-y-3 text-base">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="link-underline text-ink hover:text-accent transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>
</BaseLayout>
