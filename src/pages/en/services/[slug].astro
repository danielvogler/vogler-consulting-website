---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import ServiceDetail from '~/components/ServiceDetail.astro';
import ServiceSchema from '~/components/ServiceSchema.astro';
import { CONTACT_EMAIL } from '~/data/contact';
import { hasServiceDetail, serviceDetailSlug } from '~/data/service-details';
import { labelForTrack } from '~/data/service-groups';

const lang = 'en' as const;

export async function getStaticPaths() {
  const entries = await getCollection(
    'services',
    (e) => e.data.lang === 'en' && hasServiceDetail(e),
  );
  return entries.map((entry) => ({
    params: { slug: serviceDetailSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const pageTitle = `${entry.data.title} · VOGLER CONSULTING`;

const labels = {
  eyebrow: `Service · ${labelForTrack(entry.data.track, lang)}`,
  situation: 'The situation',
  approach: 'How we work',
  deliverable: 'Deliverable:',
  workstreams: 'Fields of action',
  outcomes: 'What you get',
  frame: 'Engagement',
  duration: 'Duration',
  involvement: 'Who is involved',
  format: 'Format',
  entryPoint: 'Getting started',
};
---

<BaseLayout title={pageTitle} description={entry.data.bluf} lang={lang}>
  <ServiceSchema
    name={entry.data.title.replace(/\n/g, ' ')}
    description={entry.data.bluf}
    servicesHref="/en/services"
    servicesLabel="Services"
    workstreams={entry.data.workstreams}
    outcomes={entry.data.outcomes}
  />

  <ServiceDetail entry={entry} lang={lang} labels={labels} />

  <ContactCTA lang={lang} contactHref={`mailto:${CONTACT_EMAIL}`} />
</BaseLayout>
