---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import WorkshopDetail from '~/components/WorkshopDetail.astro';
import CourseSchema from '~/components/CourseSchema.astro';
import { isWorkshop, workshopSlug } from '~/data/workshops';
import { CONTACT_EMAIL } from '~/data/contact';

const lang = 'en' as const;

export async function getStaticPaths() {
  const entries = await getCollection('services', (e) => e.data.lang === 'en' && isWorkshop(e));
  return entries.map((entry) => ({
    params: { slug: workshopSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const pageTitle = `${entry.data.title} · VOGLER CONSULTING`;

const labels = {
  eyebrow: 'Workshop · On demand',
  takeaways: "What you'll take away",
  audience: "Who it's for",
  format: 'Format',
  agenda: 'Agenda',
  details: 'Details',
  duration: 'Duration',
  languages: 'Languages',
  locations: 'Locations',
  booking: 'Booking',
};
---

<BaseLayout title={pageTitle} description={entry.data.bluf} lang={lang}>
  <CourseSchema
    name={entry.data.title}
    description={entry.data.bluf}
    teaches={entry.data.topics}
    languages={entry.data.languages}
    locations={entry.data.locations}
    booking={entry.data.booking}
    duration={entry.data.duration}
  />

  <WorkshopDetail entry={entry} lang={lang} labels={labels} />

  <ContactCTA lang={lang} contactHref={`mailto:${CONTACT_EMAIL}`} />
</BaseLayout>
