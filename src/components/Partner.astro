---
interface Props {
  name: string;
  url?: string;
  kind: 'partner' | 'project';
}

const { name, url, kind } = Astro.props;
const kindLabel = kind === 'partner' ? 'Partner' : 'Project';
---
<article class="grid grid-cols-12 gap-6 py-10 border-t border-rule">
  <div class="col-span-12 md:col-span-3">
    <p class="text-xs tracking-wider uppercase text-muted">{kindLabel}</p>
  </div>
  <div class="col-span-12 md:col-span-9">
    {url ? (
      <a href={url} class="text-2xl md:text-3xl tracking-tighter font-medium link-underline" rel="noopener noreferrer" target="_blank">
        {name}
      </a>
    ) : (
      <h3 class="text-2xl md:text-3xl tracking-tighter font-medium">{name}</h3>
    )}
    <div class="mt-3 text-sm text-muted leading-relaxed max-w-2xl">
      <slot />
    </div>
  </div>
</article>
