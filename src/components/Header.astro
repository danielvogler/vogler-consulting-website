---
import { getCollection } from 'astro:content';
import { isWorkshop, workshopHref } from '~/data/workshops';
import { hasServiceDetail, serviceDetailHref } from '~/data/service-details';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  lang: 'de' | 'en';
  navLinks: NavLink[];
  contactLabel: string;
  contactHref: string;
}

const { lang, navLinks, contactLabel, contactHref } = Astro.props;
const homeHref = lang === 'de' ? '/' : '/en';
const servicesHref = lang === 'de' ? '/services' : '/en/services';

const allServices = await getCollection('services', (e) => e.data.lang === lang);
allServices.sort((a, b) => a.data.order - b.data.order);

const consulting = allServices.filter(hasServiceDetail).map((entry) => ({
  title: entry.data.title.replace(/\n/g, ' '),
  href: serviceDetailHref(entry),
}));

const workshops = allServices.filter(isWorkshop).map((entry) => ({
  title: entry.data.title.replace(/\n/g, ' '),
  href: workshopHref(entry),
}));

const dropdownGroups = [
  { label: lang === 'de' ? 'Beratung' : 'Consulting', items: consulting },
  { label: 'Workshops', items: workshops },
].filter((group) => group.items.length > 0);

const viewAllLabel = lang === 'de' ? 'Alle Leistungen' : 'All services';
---

<header
  data-site-header
  class="fixed top-0 inset-x-0 z-50 transition-[background-color,backdrop-filter,border-color] duration-300"
>
  <div
    class="mx-auto max-w-(--container-content) px-6 md:px-10 py-5 flex items-center justify-between"
  >
    <a
      href={homeHref}
      class="font-medium tracking-tight text-base md:text-lg whitespace-nowrap hover:text-accent transition-colors"
      aria-label="VOGLER CONSULTING, home"
    >
      VOGLER CONSULTING<span class="text-accent">.</span>
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      {
        navLinks.map((link) => {
          const hasDropdown = link.href === servicesHref && dropdownGroups.length > 0;
          if (!hasDropdown) {
            return (
              <a href={link.href} class="text-sm text-ink/80 hover:text-ink link-underline">
                {link.label}
              </a>
            );
          }
          return (
            <div class="relative group">
              <a
                href={link.href}
                class="text-sm text-ink/80 hover:text-ink link-underline inline-flex items-center gap-1"
                aria-haspopup="true"
              >
                {link.label}
                <svg
                  class="w-3 h-3 transition-transform group-hover:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </a>
              <div class="absolute left-0 top-full pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible focus-within:opacity-100 focus-within:visible transition-opacity duration-150">
                <div
                  class="w-80 max-h-[70vh] overflow-y-auto bg-paper border border-rule py-2 shadow-sm"
                  role="menu"
                >
                  {dropdownGroups.map((group, groupIndex) => (
                    <div class={groupIndex > 0 ? 'border-t border-rule/60 mt-1 pt-1' : ''}>
                      <p class="px-4 py-2 text-xs tracking-wider uppercase text-accent">
                        {group.label}
                      </p>
                      {group.items.map((item) => (
                        <a
                          href={item.href}
                          class="block px-4 py-2 text-sm text-ink/85 hover:bg-ink/[0.04] hover:text-ink transition-colors"
                          role="menuitem"
                        >
                          {item.title}
                        </a>
                      ))}
                    </div>
                  ))}
                  <div class="border-t border-rule/60 mt-1 pt-1">
                    <a
                      href={link.href}
                      class="block px-4 py-2 text-sm text-accent hover:bg-ink/[0.04] transition-colors"
                      role="menuitem"
                    >
                      {viewAllLabel} →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-4">
      <slot name="language-switcher" />
      <a
        href={contactHref}
        class="hidden sm:inline-flex items-center text-sm font-medium px-4 py-2 border border-ink/20 hover:bg-ink hover:text-paper hover:border-ink transition-colors"
      >
        {contactLabel}
      </a>
    </div>
  </div>
</header>

<style>
  header[data-site-header] {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }
  header[data-site-header][data-scrolled='true'] {
    background-color: color-mix(in oklab, var(--color-paper) 80%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom-color: var(--color-rule);
  }
</style>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header) {
    const update = () => {
      const scrolled = window.scrollY > window.innerHeight * 0.6;
      header.setAttribute('data-scrolled', String(scrolled));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
